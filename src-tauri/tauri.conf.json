{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MineContext",
  "version": "1.0.1",
  "identifier": "com.minecontext.desktop",
  "build": {
    "frontendDist": "../frontend/out/renderer",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "resources": { "../target/debug/mc-daemon": "backend/mc-daemon" }
  }
}
