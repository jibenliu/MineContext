{
  "name": "MineContext",
  "version": "1.0.7",
  "description": "MineContext 桌面端：Tauri 外壳 + React/TypeScript 渲染层",
  "author": "example.com",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "build:web": "vite build",
    "dev": "vite",
    "format": "prettier --write .",
    "lint": "node scripts/check-file-names.mjs && eslint --cache . --max-warnings 0",
    "test": "npm run test:adapters && npm run test:shared && npm run test:pages",
    "test:adapters": "node --experimental-strip-types --test src/renderer/src/adapters/__tests__/*.test.ts",
    "test:pages": "vitest run --config vitest.config.ts",
    "test:shared": "node --test packages/shared/**/__tests__/*.test.ts",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.14",
    "@ai-sdk/react": "^2.0.30",
    "@arco-design/color": "0.4.0",
    "@arco-design/web-react": "^2.66.16",
    "@milkdown/crepe": "^7.15.5",
    "@milkdown/kit": "^7.15.5",
    "@milkdown/react": "^7.15.5",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@reduxjs/toolkit": "^2.2.5",
    "@zhongyao/heatmap": "^0.0.6",
    "ahooks": "^3.9.5",
    "ai": "^5.0.30",
    "allotment": "^1.20.4",
    "axios": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.18",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.542.0",
    "mitt": "^3.0.1",
    "react": "^19.1.0",
    "react-arborist": "^3.4.2",
    "react-dom": "^19.1.0",
    "react-redux": "^9.1.2",
    "react-router": "6",
    "react-router-dom": "6",
    "react-syntax-highlighter": "^15.6.6",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "remove-markdown": "^0.6.2",
    "streamdown": "^1.1.10",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.8",
    "use-stick-to-bottom": "^1.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^2.0.0",
    "@eslint/js": "^9.33.0",
    "@swc/plugin-styled-components": "^7.1.5",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/lodash": "^4.17.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "chardet": "^2.1.0",
    "code-inspector-plugin": "^0.20.14",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "fetch-socks": "1.3.2",
    "globals": "^17.13.0",
    "iconv-lite": "^0.6.3",
    "jsdom": "^30.1.1",
    "less": "^4.4.0",
    "lodash": "^4.17.21",
    "markdown-it": "^14.1.0",
    "p-queue": "^8.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-sort-json": "^4.1.1",
    "proxy-agent": "^6.5.0",
